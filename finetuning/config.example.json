{
  "version": "v0.5.2",
  "provider": "vast",
  "providers": {
    "vast": {
      "gpu": "RTX_4090",
      "max_price_per_hour": 0.6,
      "timeout_hours": 7
    }
  },
  "storage": {
    "private_bucket": "openjevx-train",
    "public_bucket": "openjevx",
    "destroy_url": "https://openjevx-destroy.pages.dev/destroy",
    "note": "shards, runs, checkpoints and gate reports go to the private bucket; only released 8-bit models go public"
  },
  "model": {
    "format": "8-bit ONNX (weight-only int8)",
    "max_w8_mb": 750
  },
  "dataprep": {
    "generators": [
      "gen_basics.py",
      "gen_conditions.py",
      "gen_rule_reading.py",
      "gen_it_worker.py",
      "gen_logs.py",
      "convert_public.py",
      "convert_loghub_labels.py"
    ],
    "extra_train": [
      {
        "file": "train/it_worker_train.jsonl",
        "repeat": 1
      },
      {
        "file": "train/conditions_train.jsonl",
        "repeat": 1
      },
      {
        "file": "train/basics_train.jsonl",
        "repeat": 5
      },
      {
        "file": "train/rule_reading_train.jsonl",
        "repeat": 2
      },
      {
        "file": "train/logs_train.jsonl",
        "repeat": 1
      },
      {
        "file": "incoming/public/bigvul_train.jsonl",
        "repeat": 1
      },
      {
        "file": "incoming/public/defect_detection_train.jsonl",
        "repeat": 1
      },
      {
        "file": "incoming/public/hdfs_logs_train.jsonl",
        "repeat": 1
      },
      {
        "file": "incoming/public/code_search_train.jsonl",
        "repeat": 1
      },
      {
        "file": "incoming/public/ms_marco_train.jsonl",
        "repeat": 1
      },
      {
        "file": "incoming/public/bgl_logs_train.jsonl",
        "repeat": 1
      }
    ],
    "extra_eval": [
      "eval/it_worker_eval.jsonl",
      "eval/conditions_eval.jsonl",
      "eval/logs_eval.jsonl",
      "incoming/public/bigvul_eval.jsonl",
      "incoming/public/defect_detection_eval.jsonl",
      "incoming/public/hdfs_logs_eval.jsonl",
      "incoming/public/code_search_eval.jsonl",
      "incoming/public/ms_marco_eval.jsonl",
      "incoming/public/bgl_logs_eval.jsonl"
    ],
    "budget_gb": 0.2
  },
  "datavalidate": {
    "leak_train": [
      "train/train_openjevx.jsonl",
      "train/it_worker_train.jsonl",
      "train/conditions_train.jsonl",
      "train/basics_train.jsonl",
      "train/rule_reading_train.jsonl",
      "train/logs_train.jsonl"
    ],
    "leak_eval": [
      "eval/eval_openjevx.jsonl",
      "eval/it_worker_eval.jsonl",
      "eval/conditions_eval.jsonl",
      "gate/conditions_basics_gate.jsonl",
      "gate/basics_gate.jsonl",
      "eval/cases_rules.jsonl",
      "eval/cases_llm.jsonl",
      "eval/test.json",
      "eval/questions_1000.csv",
      "eval/logs_eval.jsonl",
      "gate/logs_gate.jsonl",
      "gate/public_danluu_postmortems.jsonl"
    ]
  },
  "train": {
    "EPOCHS": "1",
    "MICRO_BATCH": "16",
    "GRAD_ACCUM": "4",
    "MAX_LEN": "512",
    "AMP": "bf16",
    "GRAD_CKPT": "0",
    "MAX_HOURS": "5.0",
    "CALIB_MAX": "400",
    "EVAL_MAX": "3000",
    "ACC_GATE": "0.55"
  },
  "gate": {
    "port": 21126,
    "jevx_profile": "openjevx-new",
    "files": [
      "gate/basics_gate.jsonl",
      "gate/conditions_basics_gate.jsonl",
      "eval/conditions_eval.jsonl",
      "eval/it_worker_eval.jsonl",
      "gate/logs_gate.jsonl"
    ],
    "basics_files": [
      "gate/basics_gate.jsonl",
      "gate/conditions_basics_gate.jsonl"
    ],
    "min_basics_confident_right": 0.9,
    "max_basics_confident_wrong": 0.02,
    "min_jevx13_correct": 12
  }
}
