---
import '../styles/global.css';

const { title, description } = Astro.props;
const base = import.meta.env.BASE_URL;
const nav = [
  { href: `${base}/`, label: 'Home' },
  { href: `${base}/journey/`, label: 'The journey' },
  { href: `${base}/results/`, label: 'Before / after' },
  { href: `${base}/use/`, label: 'Use it' },
  { href: `${base}/finetune/`, label: 'Fine-tune it' },
];
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title} · OpenJevX</title>
  <meta name="description" content={description} />
  <link rel="icon" href="data:," />
</head>
<body>
  <header class="site">
    <nav class="site">
      <a class="brand" href={`${base}/`}>OpenJevX</a>
      {nav.map((item) => <a class="navlink" href={item.href}>{item.label}</a>)}
      <a class="navlink" href="https://github.com/muthuishere/openjevx" target="_blank" rel="noopener">GitHub ↗</a>
    </nav>
  </header>
  <main class="wrap">
    <slot />
  </main>
  <footer class="site">
    <div class="wrap">
      OpenJevX · Apache-2.0 ·
      <a href="https://github.com/muthuishere/openjevx">GitHub</a> ·
      <a href="https://github.com/muthuishere/openjevx/releases/latest">Releases</a> ·
      <a href="https://huggingface.co/muthuishere/openjevx">Hugging Face</a> ·
      <a href="https://github.com/muthuishere/jevx">jevx</a>
    </div>
  </footer>
  <script>
    document.addEventListener('click', (e) => {
      const btn = e.target instanceof Element ? e.target.closest('[data-copy-btn]') : null;
      if (!btn) return;
      const card = btn.closest('.code-card');
      const codeEl = card ? card.querySelector('pre code') : null;
      if (!codeEl) return;
      const text = codeEl.textContent || '';
      navigator.clipboard.writeText(text).then(() => {
        const original = btn.textContent;
        btn.textContent = 'Copied';
        btn.classList.add('copied');
        setTimeout(() => {
          btn.textContent = original;
          btn.classList.remove('copied');
        }, 1500);
      }).catch(() => {});
    });
  </script>
</body>
</html>
