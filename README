#!/bin/sh
# OpenJevX — run this file. No Python.
# Linux / macOS:  ./README
# Windows:        README.cmd
# Config file openjevx.json next to this file:
#   { "listen": "127.0.0.1:21118", "device": "cpu" }
# The model is the folder model/ next to this file (from openjevx-model-<version>.tar.gz);
# "model" in openjevx.json points elsewhere. gpu needs a CUDA ONNX Runtime and
# refuses to fall back to CPU.
cd "$(dirname "$0")" || exit 1
if [ ! -x ./openjevx ]; then
  echo "OpenJevX: missing ./openjevx next to README" >&2
  exit 1
fi
exec ./openjevx "$@"
